    .db-chart {
        position: relative; height: 100%;
        padding: 1.25rem 4rem 1.1rem;
        /* grid 的 minmax(0,1fr) 不會像 flex:1 那樣被內容撐開 */
        display: grid; grid-template-rows: auto minmax(0, 1fr);
        min-width: 0; min-height: 0;
