    }
    .db-chart:hover .db-read { opacity: 1; }

    .db-plot { position: relative; min-height: 0; margin-top: 0.9rem; }
    .db-cols { position: absolute; inset: 0 0 46px; display: flex; gap: 10px; align-items: stretch; }
    .db-col {
        flex: 1; min-width: 0; position: relative;
        display: flex; flex-direction: column; justify-content: flex-end;
        text-decoration: none; color: inherit;
        background: color-mix(in srgb, var(--haze) 26%, transparent);
