    /* 遮罩：讓浮在上面的字在任何一張圖上都讀得到 */
    .hr-scrim {
        position: absolute; inset: 0; pointer-events: none;
        background:
            linear-gradient(to top, color-mix(in srgb, var(--paper) 88%, transparent) 0%,
