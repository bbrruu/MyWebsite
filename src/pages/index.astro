    .hero-about:hover .ha-frame { transform: rotate(0deg) scale(1.03); }
    .ha-frame img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }

    /* ── 右欄：最近更新。媒體滿版當底，文字浮在上面 ── */
    .hero-recent {
        position: relative;
        z-index: 3;
        min-height: 0;
        overflow: hidden;
        display: block;
        border-left: 1px solid var(--hair);
        text-decoration: none;
        color: inherit;
    }
    .hr-bg { position: absolute; inset: 0; background: var(--paper-lift); }
    /* 照片往霧裡退：去飽和、降對比、透出底下的紙色。
       KV 本身就是把攝影層洗到接近白，硬留成一塊深色板會變成外來物。 */
    .hr-img {
        width: 100%; height: 100%; object-fit: cover; display: block;
        opacity: 0.42;
        filter: saturate(0.18) contrast(0.82) brightness(1.28);
        transition: opacity 0.5s ease, filter 0.5s ease, transform 0.6s ease;
    }
    /* 染上主色調的藍：blend color 只換色相與彩度，保留照片自己的明暗結構 */
    .hr-tint {
        position: absolute; inset: 0; pointer-events: none;
        background: var(--haze);
        mix-blend-mode: color;
        opacity: 0.55;
    }
    /* hover 才讓照片回到比較清楚的樣子——當作「靠近看」的獎勵 */
    .hero-recent:hover .hr-img {
        opacity: 0.72;
        filter: saturate(0.5) contrast(0.94) brightness(1.06);
        transform: scale(1.02);
    }
    /* YouTube 縮圖只有 480×360，滿版一定會糊，所以直接承認並柔化 */
    .hr-img.blurup { filter: saturate(0.62) contrast(0.94) brightness(1.05) blur(1.5px); transform: scale(1.06); }
    .hero-recent:hover .hr-img.blurup { filter: saturate(0.8) blur(1px); }

    .hr-sky { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    /* 浮動文字集中在左側，所以時間跨度放右下角，兩者不會撞在一起 */
    .hr-span {
        position: absolute; right: 2rem; bottom: 1.2rem; z-index: 3;
        font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 2px;
        color: var(--muted);
