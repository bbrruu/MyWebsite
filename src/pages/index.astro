---
import { existsSync } from "node:fs";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allJournalPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allResearchPosts = (await getCollection("research")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allReadingPosts = (await getCollection("reading")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allMusicPosts = (await getCollection("music")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allNotesPosts = (await getCollection("notes")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allProjects = (await getCollection("projects")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredProjects = allProjects
    .filter((p: CollectionEntry<"projects">) => p.data.featured)
    .slice(0, 3);

// ══ 首頁右上「最近更新」：跨全部 collection 找最新的一筆 ═══════════
// 圖片走退路階梯：heroImage → 內文第一張圖 → coverImage → YouTube → 星空。
// 每一層都可能是空的，所以最後一定要有星空接住，不會開天窗。
function firstBodyImage(body: string | undefined): string | undefined {
    if (!body) return undefined;
    const m = body.match(/!\[[^\]]*\]\(([^)]+)\)/);
    return m ? m[1] : undefined;
}

type Recent = {
    href: string; kind: string; kindEn: string;
    date: Date; title: string; desc: string;
    image?: string; imageKind?: "photo" | "cover" | "youtube";
    youtubeId?: string;
};

const recentCandidates: Recent[] = [
    ...allJournalPosts.map((p) => ({
        href: `/blog/${p.id}`, kind: "生活隨筆", kindEn: "JOURNAL",
        date: p.data.pubDate, title: p.data.title,
        desc: p.data.quote ?? "",
        image: p.data.heroImage ?? firstBodyImage(p.body),
        imageKind: "photo" as const,
    })),
    ...allNotesPosts.map((p) => ({
        href: `/notes/${p.id}`, kind: "學習筆記", kindEn: "NOTES",
        date: p.data.pubDate, title: p.data.title,
        desc: p.data.description ?? "",
    })),
    ...allResearchPosts.map((p) => ({
        href: `/research/${p.id}`, kind: "讀讀文獻", kindEn: "RESEARCH",
        date: p.data.pubDate, title: p.data.title,
        desc: p.data.abstract ?? "",
    })),
    ...allReadingPosts.map((p) => ({
        href: `/reading/${p.id}`, kind: "看看書籍", kindEn: "READING",
        date: p.data.pubDate, title: p.data.title,
        desc: `${p.data.bookTitle} · ${p.data.author}`,
        image: p.data.coverImage, imageKind: "cover" as const,
    })),
    ...allMusicPosts.map((p) => ({
        href: `/music/${p.id}`, kind: "聽聽音樂", kindEn: "MUSIC",
        date: p.data.pubDate, title: p.data.songName,
        desc: p.data.artist,
        image: p.data.youtubeId
            ? `https://img.youtube.com/vi/${p.data.youtubeId}/maxresdefault.jpg`
            : undefined,
        imageKind: "youtube" as const,
        youtubeId: p.data.youtubeId,
    })),
    ...allProjects.map((p) => ({
        href: `/projects/${p.id}`, kind: "作品集", kindEn: "PROJECTS",
        date: p.data.pubDate, title: p.data.title,
        desc: p.data.description,
        image: p.data.coverImage, imageKind: "cover" as const,
    })),
];

const recent = recentCandidates
    .sort((a, b) => b.date.valueOf() - a.date.valueOf())[0];

const recentDateStr = recent
    ? recent.date.toLocaleDateString("zh-TW", { year: "numeric", month: "2-digit", day: "2-digit" })
    : "";

// 星空：一顆星 = 一篇文章。只需要分類和日期，標題用來決定位置。
const skyPosts = recentCandidates.map((r) => ({
    c: r.kindEn,
    t: r.date.valueOf(),
    k: r.title,
}));

// ── 分類模板圖 ─────────────────────────────────────────────
// 沒有任何實際圖片時，用該分類的模板圖；連模板圖都沒有才退回星空。
// 用 existsSync 在 build 時檢查，所以之後把檔案丟進 public/images/fallback/
// 就會自動生效，不需要再改這裡。
const fallbackSlug: Record<string, string> = {
    JOURNAL: "journal", NOTES: "notes", RESEARCH: "research",
    READING: "reading", MUSIC: "music", PROJECTS: "projects",
};

function sectionFallback(kindEn: string | undefined): string | undefined {
    if (!kindEn) return undefined;
    const slug = fallbackSlug[kindEn];
    if (!slug) return undefined;
    for (const ext of ["jpg", "jpeg", "png", "webp"]) {
        const rel = `images/fallback/${slug}.${ext}`;
        if (existsSync(new URL(`../../public/${rel}`, import.meta.url))) {
            return `/${rel}`;
        }
    }
    return undefined;
}

const heroImage = recent?.image ?? sectionFallback(recent?.kindEn);
const heroIsYouTube = Boolean(recent?.image) && recent?.imageKind === "youtube";

// 角落的說明用時間跨度，不重複下方儀表板已經說過的總篇數
const skyTimes = skyPosts.map((p) => p.t);
const fmtSpan = (t: number) => {
    const d = new Date(t);
    return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`;
};
const skySpan = skyTimes.length
    ? `${fmtSpan(Math.min(...skyTimes))} — ${fmtSpan(Math.max(...skyTimes))}`
    : "";

const slogans = [
    "想買一桶冰淇淋暴挖起來吃",
    "有一隻貓咪叫做高麗菜",
    "中文字體要什麼才會好看呢",
    "蛋餅蛋餅九層塔蛋餅",
];
const randomSlogan = slogans[Math.floor(Math.random() * slogans.length)];

// ══ 下半儀表板：各分類篇數 ═══════════════════════════════════════
// 資料落差很大（17:1），所以「軌道」等寬滿高可點、「填充」才按篇數等比，
// 並給最矮的保底 14%，讓 2 篇和 1 篇分得出來。比例既然壓過了就不畫刻度線。
const BAR_FLOOR = 14;   // 最矮的百分比
const BAR_TOP = 86;     // 最高的百分比（留空間給頂端讀數，不頂到天花板）

const barSource = [
    { name: "生活隨筆", en: "JOURNAL",  unit: "篇", href: "/blog",     items: allJournalPosts,  latest: allJournalPosts[0]?.data.title },
    { name: "聽聽音樂", en: "MUSIC",    unit: "首", href: "/music",    items: allMusicPosts,    latest: allMusicPosts[0]?.data.songName },
    { name: "作品集",   en: "PROJECTS", unit: "個", href: "/projects", items: allProjects,      latest: allProjects[0]?.data.title },
    { name: "讀讀文獻", en: "RESEARCH", unit: "篇", href: "/research", items: allResearchPosts, latest: allResearchPosts[0]?.data.title },
    { name: "看看書籍", en: "READING",  unit: "本", href: "/reading",  items: allReadingPosts,  latest: allReadingPosts[0]?.data.title },
    { name: "學習筆記", en: "NOTES",    unit: "篇", href: "/notes",    items: allNotesPosts,    latest: allNotesPosts[0]?.data.title },
];

const barMax = Math.max(1, ...barSource.map((b) => b.items.length));
const totalPosts = barSource.reduce((n, b) => n + b.items.length, 0);

const bars = barSource
    .map((b) => {
        const count = b.items.length;
        const ratio = barMax > 1 ? (count - 1) / (barMax - 1) : 1;
        return {
            name: b.name, en: b.en, unit: b.unit, href: b.href,
            count, latest: b.latest,
            // 含有全站最新一篇的那一欄用沙色標記，跟上方「最近更新」呼應
            newest: recent ? b.href.startsWith(`/${recent.kindEn.toLowerCase()}`) || recent.href.startsWith(b.href) : false,
            pct: count === 0 ? 0 : ((BAR_FLOOR + ratio * (100 - BAR_FLOOR)) * BAR_TOP) / 100,
        };
    })
    .sort((a, b) => b.count - a.count);

const slides = [
    {
        name: "生活隨筆", en: "JOURNAL", unit: "篇",
        href: "/blog", count: allJournalPosts.length,
        latest: allJournalPosts[0]?.data.title ?? null,
    },
    {
        name: "學習筆記", en: "NOTES", unit: "篇",
        href: "/notes", count: allNotesPosts.length,
        latest: allNotesPosts[0]?.data.title ?? null,
    },
    {
        name: "讀讀文獻", en: "RESEARCH", unit: "篇",
        href: "/research", count: allResearchPosts.length,
        latest: allResearchPosts[0]?.data.title ?? null,
    },
    {
        name: "看看書籍", en: "READING", unit: "本",
        href: "/reading", count: allReadingPosts.length,
        latest: allReadingPosts[0]?.data.title ?? null,
    },
    {
        name: "聽聽音樂", en: "MUSIC", unit: "首",
        href: "/music", count: allMusicPosts.length,
        latest: allMusicPosts[0]
            ? `${allMusicPosts[0].data.artist} — ${allMusicPosts[0].data.songName}`
            : null,
    },
    {
        name: "作品集", en: "PROJECTS", unit: "個",
        href: "/projects", count: allProjects.length,
        latest: allProjects[0]?.data.title ?? null,
    },
];
---

<Layout title="Bruce 個人網站">

    <!-- ══ HERO：上下各半，整頁高 ══ -->
    <section id="hero-section" class="hero-section">

        <!-- 上半：左邊身分、右邊最近更新 -->
        <div class="hero-top">

            <!-- 左：原本的標題與標語，改成靠左 -->
            <div class="hero-id">
                <div class="hero-id-top">
                    <h1 class="banner-title" style="font-style: italic;">Bruce's Website</h1>
                    <div id="slogan" class="banner-slogan">{randomSlogan}</div>
                    <div class="hero-id-rule"></div>
                </div>

                <!-- 關於我：整組移到左欄右下，跟標題共用同一塊區域 -->
                <a href="/about" class="hero-about">
                    <span class="ha-text">
                        <span class="ha-nm">曾冠瑜</span>
                        <span class="ha-en">Bruce Tseng</span>
                        <span class="ha-go">查看個人簡介 <span class="ar">&#8594;</span></span>
                    </span>
                    <span class="ha-frame">
                        <img src="/images/profile.jpg" alt="曾冠瑜" width="960" height="1705" loading="lazy" transition:name="profile-photo" />
                    </span>
                </a>
            </div>

            <!-- 右：最近更新。媒體滿版當底，文字浮在上面。
                 退路：實際圖片 → 該分類的模板圖 → 星空 -->
            <a href={recent?.href ?? "/blog"} class:list={["hero-recent", { "has-photo": Boolean(heroImage) }]}>

                <div class="hr-bg">
                    {heroImage ? (
                        <img
                            src={heroImage}
                            data-fallback={heroIsYouTube
                                ? `https://img.youtube.com/vi/${recent?.youtubeId}/hqdefault.jpg`
                                : undefined}
                            alt=""
                            loading="eager"
                            fetchpriority="high"
                            class:list={["hr-img", { blurup: heroIsYouTube }]}
                        />
                        <span class="hr-tint"></span>
                    ) : (
                        <>
                            <canvas id="sky-canvas" class="hr-sky"></canvas>
                            <span class="hr-span">{skySpan}</span>
                            <script
                                type="application/json"
                                id="sky-data"
                                is:inline
                                set:html={JSON.stringify(skyPosts)}
                            />
                        </>
                    )}
                </div>

                <!-- 遮罩：讓浮在上面的字在任何一張圖上都讀得到 -->
                <div class="hr-scrim"></div>

                <div class="hr-over">
                    <div class="hr-k">
                        <span class="hr-kt">What's New</span>
                        <span class="hr-kr"></span>
                        <span class="hr-km">{recent?.kind} · {recentDateStr}</span>
                    </div>

                    <div class="hr-body">
                        <div class="hr-title">{recent?.title}</div>
                        {recent?.desc && <div class="hr-desc">{recent.desc}</div>}
                        <div class="hr-go">
                            <span class="t">閱讀全文</span>
                            <span class="ar">&#8594;</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- 下半：各分類篇數長條（關於我已移到上半左欄） -->
        <div class="hero-bottom">
            <div class="db-chart">
                <div class="db-head">
                    <b>{totalPosts}</b>
                    <span>posts across {bars.length} sections</span>
                    <span class="db-read" id="db-read"></span>
                </div>

                <div class="db-plot">
                    <div class="db-cols">
                        {bars.map((b, i) => (
                            <a
                                href={b.href}
                                class:list={["db-col", { newest: b.newest }]}
                                data-latest={b.latest ? `〈${b.latest}〉` : "尚無內容"}
                            >
                                <span
                                    class="db-fill"
                                    style={`--h:${b.pct}%; --d:${i * 90}ms`}
                                ></span>
                            </a>
                        ))}
                    </div>
                    <div class="db-axis"></div>
                    <div class="db-labels">
                        {bars.map((b) => (
                            <span class="db-lab">
                                <span class="zh">{b.name}<span class="num">{b.count}<i>{b.unit}</i></span></span>
                                <span class="en">{b.en}</span>
                            </span>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══ 內容區：snap point，之後正常 scroll ══ -->
    <div id="content-section" class="content-section">

        {featuredProjects.length > 0 && (
            <section class="featured-projects">
                <div class="fp-header">
                    <div class="fp-title-group">
                        <span class="fp-label">SIDE PROJECTS</span>
                        <h2 class="fp-title">作品集 <span class="fp-sub">FEATURED WORKS</span></h2>
                    </div>
                    <a href="/projects" class="fp-view-all">查看全部 →</a>
                </div>
                <div class="fp-grid">
                    {featuredProjects.map((project: CollectionEntry<"projects">) => (
                        <a href={`/projects/${project.id}`} class="fp-card">
                            <div class="fp-cover">
                                {project.data.coverImage
                                    ? <img src={project.data.coverImage} alt={project.data.title} />
                                    : <div class="fp-cover-placeholder"><span>{project.data.techStack[0] || "?"}</span></div>
                                }
                                <span class={`fp-status fp-status--${project.data.status.toLowerCase()}`}>
                                    {project.data.status}
                                </span>
                            </div>
                            <div class="fp-info">
                                <h3 class="fp-name">{project.data.title}</h3>
                                <p class="fp-desc">{project.data.description}</p>
                                <div class="fp-tags">
                                    {project.data.techStack.slice(0, 3).map((tech: string) => (
                                        <span class="fp-tag">{tech}</span>
                                    ))}
                                </div>
                                <div class="fp-links">
                                    {project.data.demoUrl && <span class="fp-link-badge">Demo</span>}
                                    {project.data.githubUrl && <span class="fp-link-badge">GitHub</span>}
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )}

        <section class="featured-music">
            <div class="fp-header">
                <div class="fp-title-group">
                    <span class="fp-label">SOUND & TRACKS</span>
                    <h2 class="fp-title">聽聽音樂 <span class="fp-sub">RECENT PICKS</span></h2>
                </div>
                <a href="/music" class="fp-view-all">查看全部 →</a>
            </div>
            <div class="fm-grid">
                {allMusicPosts.slice(0, 3).map((post) => (
                    <a href={`/music/${post.id}`} class="fm-card">
                        <div class="fm-cover">
                            {post.data.youtubeId
                                ? <img src={`https://img.youtube.com/vi/${post.data.youtubeId}/hqdefault.jpg`} alt={post.data.songName} />
                                : <div class="fm-cover-placeholder"><span>{post.data.artist}</span></div>
                            }
                            <span class="fm-artist">{post.data.artist}</span>
                        </div>
                        <div class="fm-info">
                            <h3 class="fm-songname">《{post.data.songName}》</h3>
                            <p class="fm-desc">{post.data.title}</p>
                        </div>
                    </a>
                ))}
            </div>
        </section>

        <div class="quad-grid">
            <section class="home-section">
                <a href="/blog" class="section-title-link">
                    <div class="title-container">
                        <h2 class="section-title">生活隨筆<div class="hover-accent-line"></div></h2>
                        <span class="section-en">JOURNAL</span>
                    </div>
                    <span class="enter-arrow">→</span>
                </a>
                <div class="section-content">
                    {allJournalPosts.slice(0, 3).map((post) => (
                        <a href={`/blog/${post.id}`} class="preview-item">
                            <div class="preview-date">
                                <span class="p-year">{post.data.pubDate.getFullYear()}</span>
                                <span class="p-day">{post.data.pubDate.getDate()}日</span>
                            </div>
                            <div class="preview-body">
                                <h3 class="p-title">{post.data.title}</h3>
                                <p class="p-excerpt">{post.data.mood || "今日無事"}</p>
                            </div>
                        </a>
                    ))}
                    <div class="see-more-wrapper">
                        <a href="/blog" class="see-more-btn">查看更多 MORE<div class="btn-line"></div></a>
                    </div>
                </div>
            </section>

            <section class="home-section">
                <a href="/research" class="section-title-link">
                    <div class="title-container">
                        <h2 class="section-title">讀讀文獻<div class="hover-accent-line"></div></h2>
                        <span class="section-en">LITERATURE</span>
                    </div>
                    <span class="enter-arrow">→</span>
                </a>
                <div class="section-content">
                    {allResearchPosts.slice(0, 3).map((post) => (
                        <a href={`/research/${post.id}`} class="preview-item">
                            <div class="preview-date">
                                <span class="p-year">{post.data.pubDate.getFullYear()}</span>
                                <span class="p-day">{post.data.pubDate.getDate()}日</span>
                            </div>
                            <div class="preview-body">
                                <h3 class="p-title">{post.data.title}</h3>
                                <p class="p-excerpt">{post.data.category || "學術探究"}</p>
                            </div>
                        </a>
                    ))}
                    <div class="see-more-wrapper">
                        <a href="/research" class="see-more-btn">查看更多 MORE<div class="btn-line"></div></a>
                    </div>
                </div>
            </section>

            <section class="home-section">
                <a href="/reading" class="section-title-link">
                    <div class="title-container">
                        <h2 class="section-title">看看書籍<div class="hover-accent-line"></div></h2>
                        <span class="section-en">READING</span>
                    </div>
                    <span class="enter-arrow">→</span>
                </a>
                <div class="section-content">
                    {allReadingPosts.slice(0, 3).map((post) => (
                        <a href={`/reading/${post.id}`} class="preview-item">
                            <div class="preview-date">
                                <span class="p-year">{post.data.pubDate.getFullYear()}</span>
                                <span class="p-day">{post.data.pubDate.getDate()}日</span>
                            </div>
                            <div class="preview-body">
                                <h3 class="p-title">{post.data.title}</h3>
                                <p class="p-excerpt">{post.data.author || "書海拾貝"}</p>
                            </div>
                        </a>
                    ))}
                    <div class="see-more-wrapper">
                        <a href="/reading" class="see-more-btn">查看更多 MORE<div class="btn-line"></div></a>
                    </div>
                </div>
            </section>

            <section class="home-section">
                <a href="/notes" class="section-title-link">
                    <div class="title-container">
                        <h2 class="section-title">學習筆記<div class="hover-accent-line"></div></h2>
                        <span class="section-en">FIELD NOTES</span>
                    </div>
                    <span class="enter-arrow">→</span>
                </a>
                <div class="section-content">
                    {allNotesPosts.slice(0, 3).map((note) => (
                        <a href={`/notes/${note.id}`} class="preview-item">
                            <div class="preview-date">
                                <span class="p-year">{note.data.pubDate.getFullYear()}</span>
                                <span class="p-day">{note.data.pubDate.getDate()}日</span>
                            </div>
                            <div class="preview-body">
                                <h3 class="p-title">{note.data.title}</h3>
                                <p class="p-excerpt">{note.data.category || "學習筆記"}</p>
                            </div>
                        </a>
                    ))}
                    <div class="see-more-wrapper">
                        <a href="/notes" class="see-more-btn">查看更多 MORE<div class="btn-line"></div></a>
                    </div>
                </div>
            </section>
        </div>

    </div><!-- end content-section -->

</Layout>

<script is:inline define:vars={{ slogans, randomSlogan }}>
    var _cleanups = [];

    // ── 清除所有 cleanup ──────────────────────────────────────
    document.addEventListener("astro:before-preparation", function () {
        _cleanups.forEach(function (fn) { fn(); });
        _cleanups = [];
        document.documentElement.classList.remove("hp-snap");
    });

    // ── 字卡展開動畫：延遲 Astro 換頁，讓 cover 先跑完（只註冊一次）──
    if (!window._cardNavDelayAdded) {
        window._cardNavDelayAdded = true;
        document.addEventListener("astro:before-preparation", function (e) {
            if (!document.documentElement.classList.contains("card-nav")) return;
            var orig = e.loader;
            e.loader = function () {
                return new Promise(function (r) { setTimeout(r, 340); })
                    .then(function () { return orig(); });
            };
        });
    }

    // ── 換頁後清除 card-nav class ────────────────────────────────
    document.addEventListener("astro:page-load", function () {
        document.documentElement.classList.remove("card-nav");
    });

    // ── Scroll Snap 啟動 ──────────────────────────────────────
    function initScrollSnap() {
        var nav = document.querySelector(".sticky-nav");
        var navH = nav ? nav.offsetHeight : 50;
        document.documentElement.style.setProperty("--nav-h", navH + "px");
        document.documentElement.classList.add("hp-snap");

        // 視窗大小改變時重算
        function onResize() {
            var n = document.querySelector(".sticky-nav");
            var h = n ? n.offsetHeight : 50;
            document.documentElement.style.setProperty("--nav-h", h + "px");
        }
        window.addEventListener("resize", onResize);
        _cleanups.push(function () { window.removeEventListener("resize", onResize); });
    }

    // ── Carousel（撲克疊牌）────────────────────────────────────

    // ── 標語輪播 ──────────────────────────────────────────────
    function initSlogan() {
        var el = document.getElementById("slogan");
        if (window._sloganTimer) clearInterval(window._sloganTimer);
        if (!el) return;
        var idx = slogans.indexOf(randomSlogan);
        function next() {
            el.style.opacity = "0";
            setTimeout(function () {
                idx = (idx + 1) % slogans.length;
                el.textContent = slogans[idx];
                el.style.opacity = "1";
            }, 500);
        }
        window._sloganTimer = setInterval(next, 3000);
        _cleanups.push(function () { clearInterval(window._sloganTimer); });
    }

    // ── 入口 ──────────────────────────────────────────────────
    document.addEventListener("astro:page-load", function () {
        if (window.location.pathname !== "/") return;
        initScrollSnap();
        initSlogan();
    });
</script>

<style is:global>
    /* ── Scroll snap（僅首頁啟用）── */
    html.hp-snap {
        scroll-snap-type: y mandatory;
        scroll-padding-top: var(--nav-h, 50px);
    }
    html.hp-snap .hero-section    { scroll-snap-align: start; }
    html.hp-snap .content-section { scroll-snap-align: start; }

</style>

<style>
    /* ══ Layout ══════════════════════════════════════════════ */

