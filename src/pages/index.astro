    .p-excerpt { font-size: 0.75rem; color: var(--muted); margin: 0; }

    .see-more-wrapper { display: flex; justify-content: flex-end; margin-top: 0.8rem; }
    .see-more-btn { text-decoration: none; color: var(--muted); font-size: 0.7rem; letter-spacing: 2px; position: relative; padding: 8px 0; transition: color 0.3s; }
    .btn-line { position: absolute; bottom: 0; right: 0; width: 30px; height: 2px; background: var(--border); transition: 0.4s; }
    .see-more-btn:hover { color: var(--accent-deep); }
    .see-more-btn:hover .btn-line { width: 100%; background: var(--accent); }

    /* ══ Responsive ══════════════════════════════════════════ */
    @media (max-width: 900px) {
        /* 兩欄擠不下就疊起來，並把 hero 上半放高一點容納兩塊 */
        .hero-top      { grid-template-columns: 1fr; grid-template-rows: auto 1fr; flex-basis: 62%; }
        .hero-id       { padding: 1.4rem 1.4rem 1rem 4rem; }
        .hero-id-rule  { margin-top: 0.9rem; }
        .hero-bottom   { flex-basis: 38%; }
        .hero-recent   { border-left: 0; border-top: 1px solid var(--hair); padding: 1rem 1.4rem 1.2rem; }
        .hr-desc       { -webkit-line-clamp: 1; }
        /* 上半堆疊；關於我縮小並回到靠左，避免右下擠在窄欄裡 */
        .hero-id       { padding: 1.4rem 1.4rem 1.2rem 4rem; }
        .hero-about    { align-self: flex-start; gap: 0.75rem; margin-top: 1.2rem; }
        .ha-text       { align-items: flex-start; text-align: left; order: 2; }
        .ha-frame      { height: 118px; order: 1; }
        .hero-bottom   { flex-basis: 38%; }
        .db-chart      { padding: 0.9rem 4rem 0.8rem; }
    }
    @media (max-width: 768px) {
        .hero-section  { margin-left: -1rem; margin-right: -1rem; width: calc(100% + 2rem); }
        .fp-grid       { grid-template-columns: 1fr; }
        .fm-grid       { grid-template-columns: 1fr; }
        .banner-title  { font-size: 2.1rem; }
        .hero-id       { padding-left: 1rem; }
        .hero-recent   { padding-left: 1rem; padding-right: 1rem; }
        .hero-id       { padding-left: 1rem; }
        .db-chart      { padding-left: 1rem; padding-right: 1rem; }
        .ha-frame      { height: 96px; }
        .db-lab .zh    { font-size: 0.62rem; }
        .db-lab .num   { font-size: 0.88rem; margin-left: 3px; }
        .db-lab .en    { display: none; }
        .db-cols       { inset: 0 0 32px; gap: 6px; }
        .db-axis       { bottom: 32px; }
        .db-labels     { height: 32px; gap: 6px; }
        .db-read       { display: none; }
        .hr-media.small { height: 84px; gap: 0.7rem; }
        .hr-thumb      { width: 108px; height: 60px; }
        .hr-thumb-note { font-size: 0.7rem; }
    }
    @media (max-width: 500px) {
        .banner-slogan { display: none; }
        .hr-desc       { display: none; }
    }
</style>

<script>
    // ══ 星空：一顆星 = 一篇文章 ══════════════════════════════
    // 只在「最近更新沒有任何圖片可用」時才會出現在 DOM 裡。
    function initSky() {
        const cv = document.getElementById("sky-canvas") as HTMLCanvasElement | null;
        const raw = document.getElementById("sky-data");
        if (!cv || !raw) return;

        let posts: { c: string; t: number; k: string }[] = [];
        try { posts = JSON.parse(raw.textContent || "[]"); } catch { return; }
        if (!posts.length) return;

        // 位置由標題雜湊決定，所以每次載入都在同一個地方，不會亂跳
        const hash = (str: string) => {
            let h = 2166136261;
            for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = (h * 16777619) >>> 0; }
            return h;
        };
        const rnd = (seed: number, n: number) => {
            const out: number[] = []; let h = seed;
            for (let i = 0; i < n; i++) { h = (h * 1103515245 + 12345) >>> 0; out.push(h / 4294967296); }
            return out;
        };

        const times = posts.map((p) => p.t);
        const tMin = Math.min(...times), tMax = Math.max(...times);
        const span = Math.max(1, tMax - tMin);

        const stars = posts.map((p) => {
            const r = rnd(hash(p.c + p.k), 3);
            const age = (p.t - tMin) / span;
            return {
                c: p.c,
                x: 0.06 + r[0] * 0.88,
                y: 0.08 + r[1] * 0.84,
                mag: 0.35 + Math.pow(age, 1.8) * 0.65,
                phase: r[2] * Math.PI * 2,
                newest: age > 0.999,
            };
        });

        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let raf = 0;

        const paint = (t: number) => {
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            const w = cv.clientWidth, h = cv.clientHeight;
            if (!w || !h) return;
            if (cv.width !== w * dpr) { cv.width = w * dpr; cv.height = h * dpr; }
            const g = cv.getContext("2d");
            if (!g) return;
            g.setTransform(dpr, 0, 0, dpr, 0, 0);
            g.clearRect(0, 0, w, h);

            const cs = getComputedStyle(document.documentElement);
            const ink = cs.getPropertyValue("--ink").trim() || "#141a1c";
            const soft = cs.getPropertyValue("--muted-soft").trim() || "#8fa4ab";
            const accent = cs.getPropertyValue("--accent").trim() || "#4e8496";

            const byCat: Record<string, typeof stars> = {};
            stars.forEach((st) => { (byCat[st.c] = byCat[st.c] || []).push(st); });
            g.lineWidth = 0.6;
            g.strokeStyle = soft;
            g.globalAlpha = 0.16;
            Object.keys(byCat).forEach((k) => {
                const list = byCat[k].slice().sort((a, b) => a.x - b.x);
                for (let i = 1; i < list.length; i++) {
                    g.beginPath();
                    g.moveTo(list[i - 1].x * w, list[i - 1].y * h);
                    g.lineTo(list[i].x * w, list[i].y * h);
                    g.stroke();
                }
            });
            g.globalAlpha = 1;

            stars.forEach((st) => {
                const tw = reduce ? 1 : 0.82 + 0.18 * Math.sin(t / 1400 + st.phase);
                const r = (0.9 + st.mag * 2.1) * tw;
                g.beginPath();
                g.arc(st.x * w, st.y * h, r, 0, Math.PI * 2);
                g.fillStyle = st.newest ? accent : ink;
                g.globalAlpha = (0.28 + st.mag * 0.6) * tw;
                g.fill();
                if (st.newest) {
                    g.beginPath();
                    g.arc(st.x * w, st.y * h, r + 4.5, 0, Math.PI * 2);
                    g.strokeStyle = accent;
                    g.globalAlpha = 0.3 * tw;
                    g.lineWidth = 1;
                    g.stroke();
                }
            });
            g.globalAlpha = 1;
        };

        const loop = (t: number) => { paint(t); raf = requestAnimationFrame(loop); };
        if (raf) cancelAnimationFrame(raf);
        if (reduce) paint(0); else raf = requestAnimationFrame(loop);

        document.addEventListener("astro:before-swap", () => {
            if (raf) cancelAnimationFrame(raf);
        }, { once: true });
    }

    // ══ YouTube maxresdefault 不是每支影片都有，404 就退回 hqdefault ══
    function initThumbFallback() {
        document.querySelectorAll<HTMLImageElement>(".hr-thumb img[data-fallback]").forEach((img) => {
            img.addEventListener("error", () => {
                const fb = img.dataset.fallback;
                if (fb && img.src !== fb) img.src = fb;
            }, { once: true });
        });
    }

    // ══ 儀表板：頂端共用讀數 ══════════════════════════════════
    // 滑過哪一欄就在標題列右側顯示那一區最新一篇。
    // 六個各自浮動的提示會互相打架，最高那根上方也沒有空間放。
    function initBarReadout() {
        const read = document.getElementById("db-read");
        const chart = document.querySelector(".db-chart");
        if (!read || !chart) return;
        chart.querySelectorAll<HTMLElement>(".db-col").forEach((col) => {
            col.addEventListener("mouseenter", () => {
                read.textContent = col.dataset.latest || "";
            });
        });
        chart.addEventListener("mouseleave", () => { read.textContent = ""; });
    }

    document.addEventListener("astro:page-load", () => {
        initSky();
        initThumbFallback();
        initBarReadout();
    });
</script>
