    .hero-about:hover .ha-go .ar { transform: translateX(4px); }
    /* 相框比例鎖死 3:4：照片是 960×1705 直式，框一變橫臉就會被裁掉 */
    .ha-frame {
        flex: none; aspect-ratio: 3 / 4; height: clamp(130px, 23vh, 215px); width: auto;
        padding: 4px; background: var(--paper-lift); border: 1px solid var(--border);
        transform: rotate(-1.5deg);
        transition: transform 0.35s ease;
