    /* ══ Hero Bottom：關於我 ＋ 篇數長條 ═══════════════════════ */
    .hero-bottom {
        flex: 0 0 46%;
        min-height: 0;
        display: block;
        /* 下半用 --paper-lift 抬起來，跟上半分成兩個平面。
